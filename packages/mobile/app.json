{
  "expo": {
    "name": "RJP Port",
    "slug": "rjp-dev",
    "version": "1.0.15",
    "newArchEnabled": false,
    "icon": "./assets/images/icon.png",
    "scheme": "rjpdev",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rjpdev.portfolio",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSContactsUsageDescription": "Save Roody's contact info directly to your phone."
      },
      "buildNumber": "35"
    },
    "android": {
      "package": "com.rjpdev.portfolio",
      "adaptiveIcon": {
        "backgroundColor": "#08080a",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 23
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#08080a"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-contacts",
      "expo-secure-store",
      "./plugins/withFollyCoroFix.js"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "22eb7709-1e2b-4312-a32c-7e12f53e7d00"
      },
      "chatApiUrl": "https://rjp-port-chat-proxy.rjpdev.workers.dev"
    },
    "owner": "rjpdev"
  }
}
